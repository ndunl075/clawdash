{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawdash",
  "version": "0.1.0",
  "identifier": "dev.clawdash.game",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "beforeBuildCommand": "pnpm --dir ../.. build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clawdash",
        "width": 1120,
        "height": 700,
        "minWidth": 480,
        "minHeight": 270,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/clawdash-cli"],
    "resources": { "../../web/dist/": "web/", "../../../dist/licenses/": "licenses/" },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" } }
  }
}
